DJANGO_SETTINGS_MODULE=core.settings.development
SECRET_KEY=change-me-must-match-across-all-services
DEBUG=True

# Database
POSTGRES_DB=auth_db
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/2
REDIS_EVENT_BUS_URL=redis://localhost:6379/3

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@mindbridge.com

# Internal service communication
INTERNAL_SERVICE_TOKEN=change-me-must-match-across-services

SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
