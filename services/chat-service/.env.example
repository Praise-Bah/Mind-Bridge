DJANGO_SETTINGS_MODULE=core.settings.development
SECRET_KEY=change-me-must-match-auth-service-secret-key
DEBUG=True

# Database
POSTGRES_DB=chat_db
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/2
REDIS_EVENT_BUS_URL=redis://localhost:6379/3

# Internal communication
INTERNAL_SERVICE_TOKEN=change-me-must-match-monolith-token
MONOLITH_INTERNAL_URL=http://monolith:8000

SITE_URL=http://localhost:3000
