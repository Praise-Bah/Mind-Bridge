# Frontend production environment variables.
# This file is committed to git (no secrets here).
#
# Set VITE_API_URL in your Vercel dashboard:
#   Project Settings → Environment Variables → Production
#   Name:  VITE_API_URL
#   Value: https://YOUR_VPS_IP_OR_DOMAIN/api/v1
#
# Example:  VITE_API_URL=https://123.45.67.89/api/v1
#           VITE_API_URL=https://mindbridge.com/api/v1
#
# Leave blank here — Vercel dashboard variables take precedence at build time.
VITE_API_URL=
