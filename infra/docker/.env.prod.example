# Production environment variables — copy to .env.prod and fill in real values.
# NEVER commit .env.prod to git.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=<STRONG_RANDOM_PASSWORD>

# ── Django / Services ─────────────────────────────────────────────────────────
# Single secret key shared by all services so JWT tokens decode cross-service.
AUTH_SECRET_KEY=<STRONG_RANDOM_SECRET_KEY_50_CHARS>

# Comma-separated list of allowed hostnames/IPs for Django ALLOWED_HOSTS.
# Add your VPS IP and domain (no http:// prefix).
# Example: 123.45.67.89,mindbridge.com,www.mindbridge.com
ALLOWED_HOSTS=<YOUR_VPS_IP_OR_DOMAIN>

# ── URLs ──────────────────────────────────────────────────────────────────────
# The VPS-facing URL (used in emails, OAuth redirects, etc.)
SITE_URL=https://<YOUR_DOMAIN_OR_IP>

# The frontend URL — your Vercel app or the VPS URL if self-hosting the frontend.
FRONTEND_URL=https://<YOUR_VERCEL_APP>.vercel.app

# ── Internal auth ─────────────────────────────────────────────────────────────
# Token used for service-to-service calls (admin aggregator → other services).
# Must be the same across all services.
INTERNAL_SERVICE_TOKEN=<STRONG_RANDOM_TOKEN_FOR_INTER_SERVICE_AUTH>

# ── External APIs ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<FROM_GOOGLE_CLOUD_CONSOLE>
GOOGLE_CLIENT_SECRET=<FROM_GOOGLE_CLOUD_CONSOLE>
SENDGRID_API_KEY=<FROM_SENDGRID_DASHBOARD>
DEFAULT_FROM_EMAIL=noreply@<YOUR_DOMAIN>
OPENROUTER_API_KEY=<FROM_OPENROUTER>
YOUTUBE_API_KEY=<FROM_GOOGLE_CLOUD_CONSOLE>
