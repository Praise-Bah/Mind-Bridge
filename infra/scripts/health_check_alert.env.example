# Copy to health_check_alert.env (NEVER commit the real one — it holds a live API key)
#   cp health_check_alert.env.example health_check_alert.env
#
# SENDGRID_API_KEY can be the same value as in infra/docker/.env.prod.
SENDGRID_API_KEY=<FROM_SENDGRID_DASHBOARD>

# Where alerts are sent — your personal inbox.
ALERT_TO=praisebah@gmail.com

# Must be a verified sender identity in your SendGrid account (Settings > Sender Authentication).
ALERT_FROM=noreply@mindbridge.sbs
