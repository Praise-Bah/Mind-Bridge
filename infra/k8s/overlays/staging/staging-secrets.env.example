# Copy to staging-secrets.env (git-ignored) and fill in real values, then:
#   export $(grep -v '^#' staging-secrets.env | xargs)
#   ./create-secrets.sh
# NEVER commit the filled-in staging-secrets.env.

POSTGRES_USER=mindbridge
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET_KEY=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
SENDGRID_API_KEY=CHANGE_ME
OPENROUTER_API_KEY=CHANGE_ME
YOUTUBE_API_KEY=CHANGE_ME

# GitHub Container Registry pull credentials (PAT needs read:packages).
GHCR_USER=your-github-username
GHCR_TOKEN=CHANGE_ME
GHCR_EMAIL=you@example.com
