# Managed by Ansible. Do not edit directly on the server.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER={{ mindbridge_postgres_user }}
POSTGRES_PASSWORD={{ mindbridge_postgres_password }}

# ── Django / Services ─────────────────────────────────────────────────────────
AUTH_SECRET_KEY={{ mindbridge_auth_secret_key }}
ALLOWED_HOSTS={{ mindbridge_allowed_hosts }}
SENTRY_DSN={{ mindbridge_sentry_dsn }}
SENTRY_ENVIRONMENT={{ mindbridge_sentry_environment }}

# ── Grafana Cloud ─────────────────────────────────────────────────────────────
GRAFANA_CLOUD_PROMETHEUS_URL={{ mindbridge_grafana_prometheus_url }}
GRAFANA_CLOUD_PROMETHEUS_USERNAME={{ mindbridge_grafana_prometheus_username }}
GRAFANA_CLOUD_API_KEY={{ mindbridge_grafana_api_key }}

# ── URLs ──────────────────────────────────────────────────────────────────────
SITE_URL={{ mindbridge_site_url }}
FRONTEND_URL={{ mindbridge_frontend_url }}

# ── Internal auth ─────────────────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN={{ mindbridge_internal_service_token }}

# ── External APIs ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID={{ mindbridge_google_client_id }}
GOOGLE_CLIENT_SECRET={{ mindbridge_google_client_secret }}
SENDGRID_API_KEY={{ mindbridge_sendgrid_api_key }}
DEFAULT_FROM_EMAIL={{ mindbridge_default_from_email }}
OPENROUTER_API_KEY={{ mindbridge_openrouter_api_key }}
YOUTUBE_API_KEY={{ mindbridge_youtube_api_key }}
